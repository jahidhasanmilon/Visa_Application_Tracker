rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos: anyone signed in can read (shown as avatars across the
    // app), but a user may only write their own file, and only a small image.
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}

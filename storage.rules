rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos: anyone signed in can read (shown as avatars across the
    // app), but a user may only write their own file, and only a small image.
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Guide attachments — any file type (PDFs render inline, other formats
    // get a download link, see GuideDetail.tsx). Public read, matching the
    // guides Firestore collection. Storage rules can't read the Firestore
    // `admins` collection (different service, no cross-service exists()),
    // so write access here is limited to the owner email only — additional
    // admins can still edit guide text via Firestore, just not upload
    // attachments, until this is wired up with custom auth claims.
    match /guides/{guideId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'jahidhasanmilon999@gmail.com'
        && request.resource.size < 25 * 1024 * 1024;
    }

    // First-time-applicant welcome image — single overwritable file, same
    // owner-only write constraint as guide attachments above.
    match /meta/welcomeImage {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'jahidhasanmilon999@gmail.com'
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
